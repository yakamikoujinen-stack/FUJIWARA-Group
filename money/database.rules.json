{
  "rules": {
    ".read": false,
    ".write": false,
    "moneyV1": {
      "roles": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid"
        }
      },
      "vouchers": {
        ".read": "auth != null && root.child('moneyV1/roles').child(auth.uid).val() === 'ceo'",
        "$id": {
          ".write": "auth != null && root.child('moneyV1/roles').child(auth.uid).val() === 'ceo' && newData.exists() && !data.child('deleted').exists() && newData.child('revision').val() === (data.exists() ? data.child('revision').val() + 1 : 1)",
          ".validate": "$id.matches(/^[A-Za-z0-9_-]{1,220}$/) && ((newData.child('voucher').exists() && !newData.child('deleted').exists()) || (data.child('voucher').exists() && newData.child('deleted').val() === true && !newData.child('voucher').exists()))",
          "revision": {
            ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() > 0"
          },
          "voucher": {
            ".validate": "newData.hasChildren([\"id\", \"date\", \"docType\", \"scope\", \"category\", \"partner\", \"amount\", \"payment\", \"status\", \"prior\", \"createdAt\", \"updatedAt\"])",
            "id": {
              ".validate": "newData.val() === $id"
            },
            "date": {
              ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
            },
            "docType": {
              ".validate": "newData.val() === \"receipt\" || newData.val() === \"received_invoice\" || newData.val() === \"issued_invoice\" || newData.val() === \"delivery\" || newData.val() === \"other\""
            },
            "scope": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100"
            },
            "category": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100"
            },
            "partner": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 120"
            },
            "amount": {
              ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() > 0 && newData.val() <= 999999999"
            },
            "payment": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60"
            },
            "status": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60"
            },
            "prior": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 80"
            },
            "event": {
              ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 120"
            },
            "eventStart": {
              ".validate": "newData.val() === '' || newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
            },
            "eventEnd": {
              ".validate": "newData.val() === '' || newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
            },
            "reviewedOn": {
              ".validate": "newData.val() === '' || newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
            },
            "number": {
              ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 80"
            },
            "details": {
              ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 800"
            },
            "fileName": {
              ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 180"
            },
            "photo": {
              ".validate": "newData.isString() && newData.val().length <= 600000 && newData.val().matches(/^data:image\\/(jpeg|png|webp);base64,[A-Za-z0-9\\+\\/]+=*$/)"
            },
            "receiptSource": {
              ".validate": "newData.val() === $id && $id.beginsWith('receipt-')"
            },
            "createdAt": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 45"
            },
            "updatedAt": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 45"
            },
            "$other": {
              ".validate": false
            }
          },
          "deleted": {
            ".validate": "newData.val() === true"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "applications": {
        ".read": "auth != null && root.child('moneyV1/roles').child(auth.uid).val() === 'ceo'",
        "$uid": {
          ".read": "auth != null && auth.uid === $uid && root.child('moneyV1/roles').child(auth.uid).val() === 'staff'",
          "$id": {
            "submission": {
              ".write": "auth != null && auth.uid === $uid && root.child('moneyV1/roles').child(auth.uid).val() === 'staff' && $id.matches(/^[0-9a-f-]{36}$/) && !data.exists() && newData.exists()",
              ".validate": "newData.hasChildren([\"name\", \"supplier\", \"photo\", \"date\", \"amount\", \"payment\", \"event\", \"note\", \"createdAt\"])",
              "name": {
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60"
              },
              "supplier": {
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100"
              },
              "photo": {
                ".validate": "newData.isString() && newData.val().length <= 600000 && newData.val().matches(/^data:image\\/(jpeg|png|webp);base64,[A-Za-z0-9\\+\\/]+=*$/)"
              },
              "date": {
                ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
              },
              "amount": {
                ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() > 0 && newData.val() <= 999999999"
              },
              "payment": {
                ".validate": "newData.val() === \"会社のお金で購入\" || newData.val() === \"スタッフ立替\""
              },
              "event": {
                ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 100"
              },
              "note": {
                ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 500"
              },
              "createdAt": {
                ".validate": "newData.isNumber() && newData.val() <= now && newData.val() >= now - 60000"
              },
              "$other": {
                ".validate": false
              }
            },
            "decision": {
              ".write": "auth != null && root.child('moneyV1/roles').child(auth.uid).val() === 'ceo' && newData.exists() && data.parent().child('submission').exists() && data.child('status').val() !== '確認済み' && newData.child('revision').val() === (data.exists() ? data.child('revision').val() + 1 : 1)",
              ".validate": "newData.hasChildren([\"status\", \"reason\", \"revision\"]) && (newData.child('status').val() !== '保留' || newData.child('reason').val().length > 0)",
              "status": {
                ".validate": "newData.val() === \"確認済み\" || newData.val() === \"保留\""
              },
              "reason": {
                ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 500"
              },
              "revision": {
                ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() > 0"
              },
              "$other": {
                ".validate": false
              }
            }
          }
        }
      }
    }
  }
}
